# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# JSON Web Token Secret (Keep secure and do not expose)
JWT_SECRET=accessguard_ai_dev_secret_key_change_in_production_987654321

# Client Origin for CORS and Cookie configuration
CLIENT_URL=http://localhost:5173

# SQLite Database File Path (relative to server root or absolute)
DATABASE_PATH=./data/accessguard.db

# Optional AI API Key (kept strictly on the backend, never exposed to frontend)
# If not configured, the system uses deterministic rule-based guidance (never fabricated)
AI_API_KEY=
